ENTORNO=desarrollo
DATABASE_URL=postgresql+psycopg://statsnostra_pruebas:pruebas_local@localhost:5432/statsnostra_pruebas
LOG_LEVEL=INFO

# Credenciales del superusuario de Postgres, solo para uso local (docker-compose)
POSTGRES_USER=statsnostra
POSTGRES_PASSWORD=statsnostra
POSTGRES_DB=statsnostra

# Passwords de los roles por ambiente (creados por scripts/db/init-schemas.sh)
PRUEBAS_DB_PASSWORD=pruebas_local
PRODUCCION_DB_PASSWORD=produccion_local

# v2 — APIs externas del equipo. Vacias por defecto: sin URL, esos campos
# salen en null en vez de fallar.
TRADING_JOURNAL_API_URL=
ECOMMERCE_API_URL=

# v2 — Cache distribuida (Memorystore/Redis). Vacio por defecto: sin host,
# se salta el cache y llama directo a la API externa.
REDIS_HOST=
REDIS_PORT=6379

# v2 — Trazas y metricas via OTLP hacia Grafana Cloud. Vacio por defecto:
# sin endpoint, OpenTelemetry no se activa.
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_USER=
GRAFANA_OTLP_TOKEN=
OTEL_SERVICE_NAME=api-gcp

# v5 — Identificacion en cada respuesta (X-App-Name y X-App-Version) y en el
# log. APP_VERSION se fija en el despliegue con la version publicada.
APP_ID=mari
APP_VERSION=0.1.0

# v5 — Interruptor de fallos del grupo. Apagado por defecto: solo con
# FAULT_HEADER_ENABLED=true la cabecera X-Inject-Fault (error o latency) hace
# algo, y nunca sobre /health ni /metrics. Para detener un experimento basta
# con ponerlo en false.
FAULT_HEADER_ENABLED=false
FAULT_ERROR_RATE=1.0
FAULT_LATENCY_MS=1000
